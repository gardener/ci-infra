# This file is generated by the renovate-presubmit-generator. DO NOT EDIT.
# It defines a renovate-config-validator presubmit for every public, non-archived and
# non-fork repository of the {{ .Org }} org, so that changes to renovate config files are
# validated before they are merged. It is kept in sync by the ci-renovate-presubmit-generator
# periodic (prow/cmd/renovate-presubmit-generator).
#
# The run_if_changed pattern matches all possible renovate config file paths, see
# https://docs.renovatebot.com/configuration-options/#configuration-options
presubmits:
{{- range $i, $repo := .Repos }}
  {{ $.Org }}/{{ $repo }}:
{{- if eq $i 0 }}
  - &renovate-presubmit
    name: pull-{{ $repo }}-check-renovate-config
    cluster: {{ $.Cluster }}
    run_if_changed: '{{ $.RunIfChanged }}'
    annotations:
      description: Runs renovate-config-validator to validate changes to renovate configs.
    decorate: true
    spec:
      containers:
      - image: {{ $.Image }}
        command:
        - renovate-config-validator
{{- else }}
  - <<: *renovate-presubmit
    name: pull-{{ $repo }}-check-renovate-config
{{- end }}
{{- end }}
